# Port, unter dem das Dashboard auf dem Docker-Host erreichbar ist.
SWITCHLY_HTTP_PORT=8080

# Zeitzone für PHP/Logs.
TZ=Europe/Berlin

# Wird nur zum Anlegen eines Admins in einer LEEREN Datenbank verwendet.
# Leer lassen = beim ersten Start sicher erzeugen und einmalig im Container-Log
# ausgeben. Ein gesetztes Passwort muss mindestens 12 Zeichen lang sein.
# Bestehende Konten werden durch spätere Änderungen nicht verändert.
SWITCHLY_ADMIN_USER=admin
SWITCHLY_ADMIN_PASSWORD=

# Öffentliche Basis-URL für Links in Verifikationsmails.
# Leer = URL automatisch aus Host bzw. X-Forwarded-Host/-Proto erkennen.
# Hinter einem Proxy kann alternativ die öffentliche URL fest gesetzt werden.
SWITCHLY_BASE_URL=

# OpenID Connect wird vollständig im CMS unter „OpenID Connect“ konfiguriert.
# Es werden keine SSO-Zugangsdaten aus der .env gelesen.

# SMTP wird nach der Anmeldung unter „Alerts“ in der GUI konfiguriert.

# Hintergrund-Monitoring für Cache, Portdaten, Logs und Down-/Recovery-Alerts.
SWITCHLY_MONITOR_ENABLED=1
SWITCHLY_MONITOR_INTERVAL=60
# CMS-/Switch-Logs nach dieser Anzahl Tage automatisch löschen.
SWITCHLY_LOG_RETENTION_DAYS=90
