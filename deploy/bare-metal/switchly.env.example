# Switchly bare-metal environment
TZ=Europe/Berlin
SWITCHLY_DB_PATH=/var/lib/switchly/database.sqlite

# Used only when the first administrator is created in an empty database.
# Leave the password empty to generate it and print it once to the service log.
SWITCHLY_ADMIN_USER=admin
SWITCHLY_ADMIN_PASSWORD=

# Recommended for verification links, OIDC and reverse-proxy deployments.
SWITCHLY_BASE_URL=

# Configure SMTP in the authenticated Alerts interface.

SWITCHLY_MONITOR_ENABLED=1
SWITCHLY_MONITOR_INTERVAL=60
SWITCHLY_LOG_RETENTION_DAYS=90
